# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
# Solo en el servidor. Nunca la publiques ni le pongas NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-o-secret
